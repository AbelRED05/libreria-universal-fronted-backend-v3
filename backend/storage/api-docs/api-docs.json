                                        "message": {
                                            "type": "string",
                                            "example": "Libro eliminado del catálogo"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflicto: libro con préstamos activos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Libros"
                ],
                "summary": "Actualizar parcialmente un libro (Requiere rol Admin o Bibliotecario)",
                "operationId": "bd80aed78f62216a7bbbee191d4df41d",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del libro",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Libro actualizado parcialmente"
                    },
                    "404": {
                        "description": "Libro no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
